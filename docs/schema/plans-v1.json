{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-peers/plans-v1",
  "title": "herdr-peers machine report (plans-v1)",
  "description": "What `herdr-peers plans --json` prints and what the autopilot daemon collects from every machine: the plans that have a lead record on this machine, each with its state as read from the plan's own state.json at the path that is valid here, and the repository of each agent pane it was told about. Read-only. Addresses are as this machine names them (its own panes are `local:`). Never carries screen text, file content, prompt text or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_version",
    "generated_at",
    "state",
    "reason",
    "plans",
    "agents"
  ],
  "properties": {
    "schema": {
      "const": "herdr-peers/plans-v1"
    },
    "report_version": {
      "type": "integer",
      "description": "Version of the report module that answered."
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "state": {
      "enum": [
        "ok",
        "unknown"
      ],
      "description": "`unknown` when the state root could not be read: the plans list is then not an answer."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "server",
          "lead",
          "epoch",
          "succession",
          "lanes",
          "repo_root",
          "plan_dir",
          "class",
          "blocker_class",
          "progress",
          "state_updated_at",
          "updated_at",
          "open_asks",
          "lead_in_repo",
          "tasks_done",
          "tasks_total",
          "current_task",
          "detail",
          "appoint",
          "appointed"
        ],
        "properties": {
          "plan": {
            "type": "string",
            "pattern": "^(?=.{1,128}$)[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "server": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The state directory (one per Herdr server) the lead record was read from."
          },
          "lead": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(local|[A-Za-z0-9._-]{1,64}):[A-Za-z0-9]{1,32}:[A-Za-z0-9]{1,32}$",
            "description": "null after `lead release`."
          },
          "epoch": {
            "type": "integer"
          },
          "succession": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(local|[A-Za-z0-9._-]{1,64}):[A-Za-z0-9]{1,32}:[A-Za-z0-9]{1,32}$"
            }
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(local|[A-Za-z0-9._-]{1,64}):[A-Za-z0-9]{1,32}:[A-Za-z0-9]{1,32}$"
            }
          },
          "repo_root": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/.{0,4095}$",
            "description": "The lead record's repository root, as this machine sees it."
          },
          "plan_dir": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/.{0,4095}$",
            "description": "Where the plan's state.json was found; null when it was not."
          },
          "class": {
            "enum": [
              "open",
              "blocked",
              "completed",
              "unreadable"
            ],
            "description": "`unreadable`: no state.json inside the repository, or one that is not a valid plan state. Never guessed."
          },
          "blocker_class": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^C[1-7]$",
            "description": "The escalation class the blocker names, when it names one."
          },
          "progress": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{16}$",
            "description": "Digest of status, task statuses, satisfied criteria, checkpoint and blocker: it changes when the plan advances and not otherwise."
          },
          "state_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "updated_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
            "description": "When the lead record was last written."
          },
          "open_asks": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Asks the lead still awaits (launched within the last two hours); null when the lead is not a pane of this machine or the log cannot be counted."
          },
          "appointed": {
            "type": "boolean",
            "description": "True when the record's current epoch came by appointment (a lane took the lead under the grant)."
          },
          "appoint": {
            "enum": ["lanes", "lanes:any-kind", null],
            "description": "The human's standing appointment grant from the lead record (lead-v2, protocol.md §12): when lead and every successor are gone, a lane may be appointed. null without a grant."
          },
          "lead_in_repo": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the lead's pane on this machine still works inside the plan's repository; false means the record names a pane that now does something else (a reused pane id), and the loop never prompts it. null when unknown."
          },
          "tasks_done": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Tasks completed or skipped; null when the state is unreadable."
          },
          "tasks_total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current_task": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Single line, at most 120 characters."
              }
            },
            "description": "The first task in progress, else blocked, else pending; null when every task is settled or the state is unreadable."
          },
          "detail": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "title",
              "tasks",
              "tasks_from",
              "blocker",
              "summary",
              "summary_at"
            ],
            "description": "Present for open and blocked plans (null otherwise): what a reader needs to follow the plan without asking its agents. Text is single-line, cleaned and cut; it is the plan's own words, shown as data.",
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "From the plan's contract or manifest."
              },
              "tasks": {
                "type": "array",
                "description": "At most 64, in plan order, starting at tasks_from.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "in_progress",
                        "completed",
                        "blocked",
                        "skipped",
                        null
                      ]
                    }
                  }
                }
              },
              "blocker": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "reason",
                  "needs",
                  "resolver"
                ],
                "properties": {
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "needs": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolver": {
                    "enum": [
                      "lead",
                      "human",
                      null
                    ],
                    "description": "Who the plan's state says may resolve the blocker (the blocker record's `resolver` field); null when it does not say."
                  }
                }
              },
              "summary": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Up to 14 lines of the plan's PROGRESS.md (goal, active task, next action, blockers), as its agents wrote them."
              },
              "summary_at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "description": "When PROGRESS.md was last written."
              },
              "tasks_from": {
                "type": "integer",
                "description": "Index of the first listed task: a plan with more than 64 tasks is shown as a window around its current task."
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pane",
          "cwd",
          "repo_root",
          "branch"
        ],
        "properties": {
          "pane": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,32}:[A-Za-z0-9]{1,32}$"
          },
          "cwd": {
            "type": "string",
            "pattern": "^/.{0,4095}$"
          },
          "repo_root": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/.{0,4095}$",
            "description": "git top level of cwd; null outside git."
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "fleet": {
      "enum": [
        "stored",
        "unchanged",
        "failed"
      ],
      "description": "Present only when the daemon sent its snapshot along: what happened to this machine's copy."
    }
  }
}
