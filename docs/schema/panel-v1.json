{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-peers/panel-v1",
  "title": "herdr-peers debate panel proposal (panel-v1)",
  "description": "What `herdr-peers debate panel --json` prints: a seating proposal that was not executed (`executed` is always false). Reused seats are idle agents in this workspace (or every workspace with --all-workspaces), minus panes in another plan's lead record and --exclude; new seats come from `ak pick` (pick-v1) round-robin over the kinds. Never carries a secret value or an account identity. Producers may add keys within a schema version; consumers must ignore unknown keys.",
  "type": "object",
  "required": ["schema", "lead", "seats", "filled", "reuse", "new", "mix", "notes", "executed"],
  "properties": {
    "schema": { "const": "herdr-peers/panel-v1" },
    "lead": { "type": "string", "description": "The lease owner address (--owner, default this pane)." },
    "seats": { "type": "integer", "minimum": 1, "maximum": 32 },
    "filled": { "type": "integer", "minimum": 0 },
    "reuse": { "type": "array",
               "items": { "type": "object", "required": ["source", "kind", "pane", "address", "reset"],
                          "properties": { "source": { "const": "reuse" },
                                          "reset": { "type": "array", "items": { "type": "string" } } } } },
    "new": { "type": "array",
             "items": { "type": "object",
                        "required": ["source", "kind", "profile", "headroom_pct", "verdict", "commands", "release"],
                        "properties": { "source": { "const": "new" },
                                        "profile": { "type": "string", "pattern": "^@[a-z0-9._-]{1,32}$" },
                                        "commands": { "type": "array", "items": { "type": "string" } },
                                        "release": { "type": "string" } } } },
    "mix": { "type": "object", "additionalProperties": { "type": "integer" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "executed": { "const": false }
  }
}
