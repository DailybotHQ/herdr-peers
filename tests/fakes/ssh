#!/usr/bin/env python3
"""Fake ssh for the autopilot loop tests (standard library only).

Logs every invocation to $FAKE_HERDR_DIR/ssh.log (one JSON line: argv, stdin
length) and plays the machine named by the target, as described by the
directory $FAKE_HERDR_DIR/ssh/<target>/:

  mode    one word (default `ok`):
            ok        run `python3 -` on the given standard input, with that
                      machine's own HOME and XDG_STATE_HOME (<dir>/home)
            down      exit 255 (connection failed)
            nopython  exit 127 (no python3 on the other side)
            garbage   print text that is not JSON, exit 0
            wrong     print a JSON object of another schema, exit 0
            big       print more than the daemon accepts, exit 0
            slow      sleep longer than the daemon waits
            flood     print without end
            hostile   print a plans-v1 report whose plan id, lead address and
                      paths are not what the schema allows, exit 0

A target with no directory is `down`. Nothing leaves this machine.
"""
import json
import os
import subprocess
import sys
import time


def main(argv):
    root = os.environ.get('FAKE_HERDR_DIR')
    if not root:
        sys.stderr.write('fake ssh: FAKE_HERDR_DIR is not set\n')
        return 2
    data = sys.stdin.buffer.read()
    with open(os.path.join(root, 'ssh.log'), 'a', encoding='utf-8') as fh:
        fh.write(json.dumps({'argv': argv, 'stdin': len(data)}) + '\n')
    if '--' not in argv:
        sys.stderr.write('fake ssh: no -- before the target\n')
        return 2
    rest = argv[argv.index('--') + 1:]
    target, command = rest[0], rest[1:]
    home = os.path.join(root, 'ssh', target)
    if not os.path.isdir(home):
        return 255
    try:
        with open(os.path.join(home, 'mode'), 'r', encoding='utf-8') as fh:
            mode = fh.read().strip() or 'ok'
    except OSError:
        mode = 'ok'
    if mode == 'down':
        return 255
    if mode == 'nopython':
        return 127
    if mode == 'garbage':
        sys.stdout.write('Welcome to the box\n')
        return 0
    if mode == 'wrong':
        sys.stdout.write(json.dumps({'schema': 'something-else', 'plans': []}) + '\n')
        return 0
    if mode == 'big':
        sys.stdout.write('x' * (3 * 1024 * 1024))
        return 0
    if mode == 'hostile':
        sys.stdout.write(json.dumps({
            'schema': 'herdr-peers/plans-v1', 'report_version': 1, 'state': 'ok', 'reason': None,
            'generated_at': '2026-01-01T00:00:00Z', 'agents': [],
            'plans': [{'plan': 'P"; touch pwned; "', 'server': 'a' * 64,
                       'lead': 'local:w1:p1 --dangerous', 'epoch': 1, 'succession': [],
                       'lanes': [], 'repo_root': '/r\n/x', 'plan_dir': None, 'class': 'open',
                       'blocker_class': None, 'progress': '0' * 16, 'state_updated_at': None,
                       'updated_at': '2026-01-01T00:00:00Z', 'open_asks': 0}]}) + '\n')
        return 0
    if mode == 'flood':
        chunk = b'x' * 65536
        try:
            while True:
                sys.stdout.buffer.write(chunk)
        except (BrokenPipeError, OSError):
            return 0
    if mode == 'slow':
        time.sleep(int(os.environ.get('FAKE_SSH_SLEEP', '60')))
        return 0
    if command != ['python3', '-']:
        sys.stderr.write('fake ssh: unexpected remote command\n')
        return 2
    env = dict(os.environ, HOME=os.path.join(home, 'home'),
               XDG_STATE_HOME=os.path.join(home, 'home', '.local', 'state'))
    for name in list(env):
        if name.startswith('HERDR_'):
            del env[name]  # the other side is not a Herdr pane
    proc = subprocess.run([sys.executable, '-'], input=data, env=env)
    return proc.returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
