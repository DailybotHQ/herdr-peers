#!/usr/bin/env python3
"""Fake agentkit `ak`: `pick` (pick-v1 for the debate scope; pick-v2 with --kinds)
and `lease` (for the autopilot brain).

FAKE_AK_DIR/pick-<kind>.json holds the `chosen` list for a kind; a kind
without a file has no account with room (exit 1). Every call is appended to
FAKE_AK_DIR/argv.log so a test can prove nothing but `pick` ran.
"""
import json
import os
import sys

root = os.environ.get('FAKE_AK_DIR', '.')
with open(os.path.join(root, 'argv.log'), 'a', encoding='utf-8') as fh:
    fh.write(' '.join(sys.argv[1:]) + '\n')
args = sys.argv[1:]
if args[:1] == ['lease']:
    # FAKE_AK_DIR/lease-rc holds the exit status to return (default 0).
    try:
        rc = int(open(os.path.join(root, 'lease-rc')).read().strip())
    except (OSError, ValueError):
        rc = 0
    sys.exit(rc)
if args[:1] == ['pick'] and '--kinds' in args:
    # FAKE_AK_DIR/pick-v2.json is printed as is (exit 0 when it qualifies, else 1);
    # without it nothing qualifies. The permission mode follows AGENTKIT_PERMISSIONS.
    path = os.path.join(root, 'pick-v2.json')
    with open(os.path.join(root, 'env.log'), 'a', encoding='utf-8') as fh:
        fh.write('AGENTKIT_PERMISSIONS=%s\n' % os.environ.get('AGENTKIT_PERMISSIONS', ''))
    if os.path.exists(path):
        doc = json.load(open(path, encoding='utf-8'))
    else:
        doc = {'schema': 'pick-v2', 'interface': 1, 'qualifies': False, 'launch': {'argv': None,
               'env_names': [], 'permissions': 'auto'}, 'soonest_reset': '2026-10-26T00:00:00Z'}
    if isinstance(doc.get('launch'), dict) and 'permissions' not in doc['launch']:
        doc['launch']['permissions'] = 'ask' if os.environ.get('AGENTKIT_PERMISSIONS') == 'ask' else 'auto'
    print(json.dumps(doc))
    sys.exit(0 if doc.get('qualifies') else 1)
if not args or args[0] != 'pick' or len(args) < 2:
    sys.stderr.write('fake ak: only `ak pick <kind>` is modelled\n')
    sys.exit(2)
kind = args[1]
count = int(args[args.index('--count') + 1]) if '--count' in args else 1
path = os.path.join(root, 'pick-%s.json' % kind)
chosen = json.load(open(path, encoding='utf-8')) if os.path.exists(path) else []
doc = {'schema': 'pick-v1', 'interface': 1, 'generated_at': '2026-10-25T00:00:00Z',
       'target': kind, 'model': None, 'reserve_pct': 10, 'need': [], 'count': count,
       'owner': args[args.index('--owner') + 1] if '--owner' in args else None,
       'chosen': chosen[:count], 'candidates': chosen,
       'soonest_reset': None if chosen else '2026-10-26T00:00:00Z'}
print(json.dumps(doc))
sys.exit(0 if chosen else 1)
