#!/usr/bin/env python3
"""Fake agentkit `ak` for the debate scope: only `pick` (pick-v1).

FAKE_AK_DIR/pick-<kind>.json holds the `chosen` list for a kind; a kind
without a file has no account with room (exit 1). Every call is appended to
FAKE_AK_DIR/argv.log so a test can prove nothing but `pick` ran.
"""
import json
import os
import sys

root = os.environ.get('FAKE_AK_DIR', '.')
with open(os.path.join(root, 'argv.log'), 'a', encoding='utf-8') as fh:
    fh.write(' '.join(sys.argv[1:]) + '\n')
args = sys.argv[1:]
if not args or args[0] != 'pick' or len(args) < 2:
    sys.stderr.write('fake ak: only `ak pick <kind>` is modelled\n')
    sys.exit(2)
kind = args[1]
count = int(args[args.index('--count') + 1]) if '--count' in args else 1
path = os.path.join(root, 'pick-%s.json' % kind)
chosen = json.load(open(path, encoding='utf-8')) if os.path.exists(path) else []
doc = {'schema': 'pick-v1', 'interface': 1, 'generated_at': '2026-10-25T00:00:00Z',
       'target': kind, 'model': None, 'reserve_pct': 10, 'need': [], 'count': count,
       'owner': args[args.index('--owner') + 1] if '--owner' in args else None,
       'chosen': chosen[:count], 'candidates': chosen,
       'soonest_reset': None if chosen else '2026-10-26T00:00:00Z'}
print(json.dumps(doc))
sys.exit(0 if chosen else 1)
